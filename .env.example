# Google Maps Platform — Places API (Text Search + Place Details)
# Get one at: https://console.cloud.google.com/google/maps-apis/credentials
# Enable the "Places API" on the project.
GOOGLE_PLACES_API_KEY=

# xAI Grok API — used for review analysis + pitch generation (model: grok-4.3).
# https://console.x.ai/
# If left blank, the script auto-loads XAI_API_KEY from ../nous-web/.env.local
# so the same key feeds both repos.
XAI_API_KEY=

# Apollo.io API key — OPTIONAL. The free plan blocks /mixed_people/search;
# only --apollo-contacts-only is useful with a free key. Anton's Apollo is
# free-tier so live --enrich runs are limited; bulk owner-name backfills run
# via MCP + a separate script (scripts/backfill-apollo-owners.js, currently
# REST-based and 403s; rewire for MCP if/when needed).
APOLLO_API_KEY=
